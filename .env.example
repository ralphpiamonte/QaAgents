JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_EMAIL=you@company.com
JIRA_API_TOKEN=your_jira_api_token

# Choose one: azure_apim (default), azure, openai
AI_PROVIDER=azure_apim

# Azure APIM proxy settings (required when AI_PROVIDER=azure_apim)
# Values often map directly from ~/.codex/config.toml:
# - base_url -> AZURE_APIM_BASE_URL
# - query param subscription-key -> AZURE_APIM_SUBSCRIPTION_KEY
# - x-openai-supplier header -> AZURE_APIM_SUPPLIER
AZURE_APIM_BASE_URL=https://your-company-proxy/openai/v1
AZURE_APIM_SUBSCRIPTION_KEY=your_apim_subscription_key
AZURE_APIM_BEARER_TOKEN=do-not-change-this-value
AZURE_APIM_SUPPLIER=YourCompany

# Azure OpenAI settings (required when AI_PROVIDER=azure)
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com
AZURE_OPENAI_API_KEY=your_azure_openai_subscription_key
OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_DEPLOYMENT=your_model_deployment_name

# OpenAI model name used by openai/azure_apim providers.
# For azure_apim, this is usually your organization's model id or alias.
OPENAI_MODEL=gpt-4.1-mini

# OpenAI settings (required when AI_PROVIDER=openai)
OPENAI_API_KEY=your_openai_api_key

# Zephyr Scale Cloud settings (required only with --publish-zephyr)
ZEPHYR_SCALE_BASE_URL=https://api.zephyrscale.smartbear.com/v2
ZEPHYR_SCALE_API_TOKEN=eyJ0eXAiOiJKV1QiLCJhbGciOiJIUzI1NiJ9..4_tyfQd7EWgXjl8qXkOHiSCBjQrJFqvCWyqDuCF5CXM
# Optional: defaults to Jira issue project prefix if omitted
ZEPHYR_SCALE_PROJECT_KEY=YOURPROJECT
# Optional: root folder used for generated test cases
ZEPHYR_SCALE_ROOT_FOLDER_NAME=Ordering _ Integrated UI

AUDIT_LOG_PATH=logs/audit.log

